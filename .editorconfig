root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ps1,psm1,psd1}]
charset = utf-8-bom
end_of_line = crlf

# Run as `irm ... | iex`, where a BOM breaks parsing. Keep it ASCII so 5.1 doesn't need one.
[install.ps1]
charset = utf-8

[*.{yml,yaml,json,md}]
indent_size = 2
end_of_line = lf

[*.md]
trim_trailing_whitespace = false
